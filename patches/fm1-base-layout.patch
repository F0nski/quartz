             units.append(("cc", *o2, *o2_more, *inc(f.parent), *ir_out, "-c", f, "-o", o.with_suffix(".ll") if ir else o))
             objs.append(o)
             o2_units.append((f, o))
+    if CONF.get("o2_first"):                      # quartz: the DSP linked before the app's code (fm1.toml o2_first = true):
+        k = objs.index(OUT / "unity.o")           # its place in the XIP flash, so how it fits the cache, stays the same
+        dsp = [o for _, o in o2_units]            # whatever the app's code grows to
