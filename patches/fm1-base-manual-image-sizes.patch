+def image_size(path):
+    """a PNG's size from its header, an SVG's from its root's viewBox: on the img, they keep the picture's room before it
+    loads (lazily), so the page does not move under a link to an anchor"""
+    data = path.read_bytes()
+    if data[:8] == b"\x89PNG\r\n\x1a\n":
+        return struct.unpack(">II", data[16:24])
+    m = re.search(rb'<svg\b[^>]*\bviewBox="\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)[\s,]+([\d.]+)', data)
+    if not m:
+        raise SystemExit(f"{path}: neither a PNG nor an SVG with a viewBox: its size is unknown")
+    return round(float(m.group(1))), round(float(m.group(2)))
