// Minimal <algorithm> for the JieLi toolchain (it ships no C++ library): what Plaits and stmlib use.
#ifndef QUARTZ_CXX_ALGORITHM
#define QUARTZ_CXX_ALGORITHM
namespace std {
template <typename T> inline const T& min(const T& a, const T& b) { return b < a ? b : a; }
template <typename T> inline const T& max(const T& a, const T& b) { return a < b ? b : a; }
template <typename T> inline void swap(T& a, T& b) { T t = a; a = b; b = t; }
template <typename It, typename T> inline void fill(It f, It l, const T& v) { for (; f != l; ++f) *f = v; }
template <typename In, typename Out> inline Out copy(In f, In l, Out o) { for (; f != l; ++f, ++o) *o = *f; return o; }
template <typename It> inline void sort(It f, It l) {
  for (It i = f; i != l; ++i)
    for (It j = i; j != f && *j < *(j - 1); --j) swap(*j, *(j - 1));
}
}
#endif
